# ---- Bootstrap secrets (only these live in .env; every API key is entered in the admin panel) ----
# Generate: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
POSTGRES_PASSWORD=change-me-long-random

# Public URL of the admin panel - used in email unsubscribe links (must be reachable by recipients)
BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

# Set true when served over HTTPS (Caddy profile)
SECURE_COOKIES=false
# Optional: domain for automatic HTTPS with `docker compose --profile https up -d`
DOMAIN=
# 127.0.0.1 = only reachable via SSH tunnel / Caddy. Use 0.0.0.0 to expose port 8000 directly (not recommended)
WEB_BIND=127.0.0.1

WORKER_CONCURRENCY=3
